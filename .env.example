# gojob 环境变量（docker compose 与二进制部署通用；优先级 GOJOB_* > 命令行 flag > 默认值）
# 复制为 .env 后按需修改:  cp .env.example .env

# ---------- Server ----------
# HTTP 监听地址
GOJOB_ADDR=:7700
# 数据库驱动: sqlite | mysql | postgres
GOJOB_DB_DRIVER=sqlite
# sqlite: 文件路径（容器内默认 /app/data/gojob.db）
GOJOB_DB_DSN=/app/data/gojob.db
# mysql 示例:
#   gojob:gojob123@tcp(127.0.0.1:3306)/gojob?charset=utf8mb4&parseTime=True&loc=Local
# postgres 示例:
#   postgres://gojob:gojob123@127.0.0.1:5432/gojob?sslmode=disable

# 首次启动播种的控制台管理员（bcrypt 存储；仅在 user_infos 为空时生效）
GOJOB_ADMIN_USER=admin
GOJOB_ADMIN_PASSWORD=admin123

# 本副本的对外可达地址：① 随心跳下发给 worker 作为长轮询目标（cluster_hint.owner/servers），
# ② 统计总览页展示。留空则按监听地址自动推导（0.0.0.0 会换成本机出口 IP）。
# 多副本部署：每个副本各填自己"worker 打得通"的地址，不能填 0.0.0.0，也不能只在本机可解析。
# 填错不会致命（worker 会退回已知副本继续跑），只是白跳一次。
GOJOB_PUBLIC_URL=http://schedule.example.com:7700

# 令牌签名密钥（集群密钥）。多副本部署**必须**给所有副本配同一个值，否则：
# 登录随机掉线、worker 心跳随机 401（票是 A 签的、请求打到 B 就验不过）。
# 留空则本进程随机生成，只在单副本下可用；日志会打 WARNING 提醒。
# 生成建议: openssl rand -hex 32
# 轮换该值会让所有在野令牌即刻失效（用户需重登、worker 自动重注册）。
GOJOB_CLUSTER_SECRET=

# ---------- 运维：数据保留与连接池 ----------
# 历史实例保留天数。终态实例（成功/失败/已停止）超过它就被连同子任务、任务日志一起删掉。
# 0 或留空 = 只认任务上显式配置的 life_cycle；两边都不配则**永不清理**，
# job_instances / instance_tasks / instance_task_logs 会一直涨（调度中心是长期进程，务必配上）。
# 多副本下每个副本只清理自己持有归属的项目。每 10 分钟一批批删（一批 20 个实例），不做一次性大事务。
GOJOB_RETENTION_DAYS=30

# 数据库连接池。不设就用内置默认：mysql/postgres 最大 20 条连接、sqlite 10 条，
# 空闲连接等于最大值一并保留，单条连接最长存活 30 分钟。
# 多副本估算：副本数 × GOJOB_DB_MAX_OPEN_CONNS ≤ 数据库 max_connections − 预留（DBA 自己的连接等）。
# MySQL 默认 max_connections=151，所以 3 副本 × 20 = 60 是安全的；worker 数量很大时可调高。
GOJOB_DB_MAX_OPEN_CONNS=
GOJOB_DB_MAX_IDLE_CONNS=
# 单条连接最长存活时间（Go 时长字面量，如 30m / 2h）。留空=30m。
# 数据库侧做过主备切换、或连接会被服务端定期回收时，调小它能更快甩掉在野的陈旧连接。
GOJOB_DB_CONN_MAX_LIFETIME=

# ---------- Demo Worker (Go SDK 示例进程) ----------
GOJOB_WORKER_SERVER=http://127.0.0.1:7700
GOJOB_WORKER_APP=demo_app
GOJOB_WORKER_PASSWORD=demo123
GOJOB_WORKER_DRAIN_ADDR=:7799

# ---------- gojob-agent（零代码执行节点：跑脚本库里的 Shell 脚本）----------
# 寻址与项目凭据沿用上面的 GOJOB_WORKER_*；默认 tag=executor，配合分发策略
# SPECIFY(tagEquals:executor) 把脚本任务只派给执行节点。
# 只允许执行这个目录里预置的脚本；不配则除非开 ALLOW_INLINE 否则什么都跑不了。
GOJOB_AGENT_SCRIPT_DIR=
# 允许把「任务参数」当脚本文本执行（含 http/https 下载脚本）。
# 开启=任何拿到项目口令的人都能在本机执行命令，请只在隔离网段这样部署。
GOJOB_AGENT_ALLOW_INLINE_SCRIPTS=false
GOJOB_AGENT_MAX_CONCURRENCY=8
GOJOB_AGENT_WORKSPACE=
GOJOB_AGENT_SCRIPT_TIMEOUT=0
GOJOB_AGENT_DRAIN_ADDR=:7800

# ---------- docker compose 内置数据库（--profile mysql / postgres 时生效）----------
GOJOB_MYSQL_ROOT_PASSWORD=root123
GOJOB_MYSQL_PASSWORD=gojob123
GOJOB_PG_PASSWORD=gojob123

# ---------- Dashboard 容器 ----------
# nginx 反代目标（compose 网络内默认服务名）
GOJOB_UPSTREAM=http://gojob-server:7700
