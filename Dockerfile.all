# 单镜像：控制台静态文件嵌入 gojob-server，7800 同端口提供页面与 API。
#   docker build -f Dockerfile.all -t gojob/gojob-all:latest .
#   docker run -d -p 7800:7800 -v gojob-data:/app/data gojob/gojob-all:latest
# 国内网络用 Dockerfile.all.cn。
FROM node:24-alpine AS ui
WORKDIR /src
# workspace 文件里带 allowBuilds（esbuild/vue-demi），缺了它 pnpm 会拒绝安装
COPY dashboard/package.json dashboard/pnpm-lock.yaml dashboard/pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY dashboard/ .
RUN pnpm build

FROM golang:1.27-alpine AS build
ARG GOJOB_VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=ui /src/dist ./server/webui/dist
RUN CGO_ENABLED=0 go build -trimpath -tags dashboard \
      -ldflags="-s -w -X main.version=${GOJOB_VERSION}" \
      -o /out/app ./cmd/gojob-server

FROM alpine:3.20
# 裸 alpine 没有 zoneinfo，Go 解析不了 TZ 就静默退回 UTC，注入 TZ=Asia/Shanghai 也无效。
# 装上 tzdata 让注入的 TZ 可解析；镜像本身不设默认 TZ，默认仍是 UTC（.cn 版才默认东八区）。
RUN apk add --no-cache tzdata
RUN adduser -D -u 10001 gojob \
 && mkdir -p /app/data \
 && chown -R gojob:gojob /app
WORKDIR /app
COPY --from=build /out/app /app/gojob
# 默认 DSN 是相对路径，固定在 data 目录，挂 named volume 才能持久化
ENV GOJOB_DB_DSN=/app/data/gojob.db
USER gojob
EXPOSE 7800
ENTRYPOINT ["/app/gojob"]
