server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA history 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    # gojob 管理面 + 兼容协议 OpenAPI → 反代到 server
    location /openapi {
        proxy_pass ${GOJOB_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 180s;
    }
    location /openApi {
        proxy_pass ${GOJOB_UPSTREAM};
        proxy_set_header Host $host;
        proxy_read_timeout 180s;
    }
}
